# Copia este archivo como .env y ajusta los valores solo si es necesario.
PORT=3000
NODE_ENV=development
APP_NAME=TaskFlow
APP_STAGE="Parte 3 - Módulo 8"
LOG_TIME_ZONE=America/Santiago

# PostgreSQL local. Reemplaza solamente la contraseña dentro de tu archivo .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow_db
DB_USER=taskflow_user
DB_PASSWORD=tu_contrasena_local
DB_SSL=false
DB_LOGGING=false

# Seguridad del Módulo 8. Reemplaza JWT_SECRET dentro de tu .env local.
JWT_SECRET=cambia_esta_clave_por_una_frase_secreta_de_32_caracteres_o_mas
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
SEED_USER_PASSWORD=TaskFlow2026!

# Multer limita los avatares a 2 MiB (máximo configurable: 5 MiB).
UPLOAD_MAX_BYTES=2097152
