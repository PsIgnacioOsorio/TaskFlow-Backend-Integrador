# Dependencias instaladas localmente
node_modules/

# Variables de entorno y secretos locales
.env
.env.*
!.env.example

# Reportes y archivos temporales
coverage/
*.log
npm-debug.log*

# Mantener el archivo solicitado por la pauta académica
