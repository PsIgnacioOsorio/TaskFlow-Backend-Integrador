<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Gestión de usuarios de {{projectName}}">
  <title>{{pageTitle}}</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
  <script defer src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script defer src="/js/users.js"></script>
</head>
<body>
  <a class="visually-hidden-focusable position-absolute top-0 start-0 p-3" href="#contenido-principal">
    Saltar al contenido
  </a>

  <nav class="navbar navbar-expand-md navbar-dark bg-primary shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-semibold" href="/">
        <span class="brand-mark me-2" aria-hidden="true">✓</span>{{projectName}}
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarTaskFlow" aria-controls="navbarTaskFlow" aria-expanded="false" aria-label="Mostrar navegación">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarTaskFlow">
        <div class="navbar-nav ms-auto">
          <a class="nav-link" href="/">Mis tareas</a>
          <a class="nav-link active" href="/users">Usuarios</a>
          <a class="nav-link" href="/status">Estado del servidor</a>
        </div>
      </div>
    </div>
  </nav>

  <main id="contenido-principal" class="container py-4 py-md-5">
    <header class="mb-4">
      <p class="text-primary fw-semibold mb-1">{{moduleName}}</p>
      <h1 class="display-6 fw-bold mb-2">Usuarios</h1>
      <p class="text-secondary mb-0">Administra las personas responsables de las tareas.</p>
    </header>

    <div class="row g-4 align-items-start">
      <aside class="col-lg-4">
        <section class="card border-0 shadow-sm form-card sticky-lg-top">
          <div class="card-body p-4">
            <h2 class="h5 mb-1">Agregar un usuario</h2>
            <p class="text-secondary small mb-4">El correo debe ser único.</p>
            <form action="/users" method="post">
              <div class="mb-3">
                <label class="form-label" for="name">Nombre</label>
                <input class="form-control" id="name" name="name" type="text" minlength="2" maxlength="80" required>
              </div>
              <div class="mb-4">
                <label class="form-label" for="email">Correo electrónico</label>
                <input class="form-control" id="email" name="email" type="email" maxlength="120" required>
              </div>
              <button class="btn btn-primary w-100" type="submit">Guardar usuario</button>
            </form>
          </div>
        </section>
      </aside>

      <section class="col-lg-8" aria-labelledby="titulo-usuarios">
        <div class="d-flex justify-content-between align-items-end mb-3">
          <div>
            <h2 id="titulo-usuarios" class="h4 mb-1">Usuarios registrados</h2>
            <p class="text-secondary small mb-0">{{userCount}} usuarios almacenados</p>
          </div>
        </div>

        {{#if users}}
          <div class="vstack gap-3">
            {{#each users}}
              <article class="card user-item border-0 shadow-sm">
                <div class="card-body p-3 p-md-4 d-flex flex-column flex-sm-row justify-content-between gap-3">
                  <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                      <h3 class="h5 mb-0">{{name}}</h3>
                      {{#if active}}
                        <span class="badge text-bg-success">Activo</span>
                      {{else}}
                        <span class="badge text-bg-secondary">Inactivo</span>
                      {{/if}}
                    </div>
                    <a href="mailto:{{email}}" class="text-secondary">{{email}}</a>
                    <div class="small text-secondary mt-2">ID: {{id}}</div>
                  </div>
                  <div class="d-flex flex-sm-column gap-2 user-actions">
                    <a class="btn btn-outline-primary btn-sm" href="/usuarios/{{id}}/tareas">Ver tareas JSON</a>
                    <form action="/users/{{id}}/delete" method="post" data-delete-user>
                      <button class="btn btn-outline-danger btn-sm w-100" type="submit">Eliminar</button>
                    </form>
                  </div>
                </div>
              </article>
            {{/each}}
          </div>
        {{else}}
          <div class="card border-0 shadow-sm text-center p-5">
            <h3 class="h5">Todavía no existen usuarios</h3>
            <p class="text-secondary mb-0">Crea el primero desde el formulario.</p>
          </div>
        {{/if}}

        <aside class="alert alert-info mt-4 mb-0" role="note">
          Las operaciones <code>PUT</code>, consultas SQL y transacciones se prueban desde la colección Postman del Módulo 7.
        </aside>
      </section>
    </div>
  </main>

  <footer class="border-top bg-white py-3">
    <div class="container d-flex flex-column flex-sm-row justify-content-between gap-1 text-secondary small">
      <span>{{projectName}} · {{currentYear}}</span>
      <span>Usuarios y tareas persistidos en PostgreSQL</span>
    </div>
  </footer>
</body>
</html>
