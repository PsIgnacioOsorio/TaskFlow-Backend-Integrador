<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Aplicación básica para organizar tareas con {{projectName}}">
  <title>{{pageTitle}}</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
  <script defer src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script defer src="/js/dashboard.js"></script>
</head>
<body>
  <a class="visually-hidden-focusable position-absolute top-0 start-0 p-3" href="#contenido-principal">
    Saltar al contenido
  </a>

  <nav class="navbar navbar-expand-md navbar-dark bg-primary shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-semibold" href="/">
        <span class="brand-mark me-2" aria-hidden="true">✓</span>{{projectName}}
      </a>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarTaskFlow"
        aria-controls="navbarTaskFlow"
        aria-expanded="false"
        aria-label="Mostrar navegación"
      >
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarTaskFlow">
        <div class="navbar-nav ms-auto">
          <a class="nav-link active" href="/">Mis tareas</a>
          <a class="nav-link" href="/status">Estado del servidor</a>
        </div>
      </div>
    </div>
  </nav>

  <main id="contenido-principal" class="container py-4 py-md-5">
    <header class="mb-4">
      <p class="text-primary fw-semibold mb-1">{{moduleName}}</p>
      <h1 class="display-6 fw-bold mb-2">Organiza tu trabajo sin complicaciones.</h1>
      <p class="text-secondary mb-0">
        Agrega tareas, revisa tus pendientes y avanza cada actividad hasta completarla.
      </p>
    </header>

    <section class="row g-3 mb-4" aria-label="Resumen de tareas">
      <div class="col-6 col-lg-3">
        <article class="card summary-card h-100 shadow-sm">
          <div class="card-body">
            <span class="text-secondary small">Total</span>
            <strong class="summary-number d-block">{{summary.total}}</strong>
          </div>
        </article>
      </div>
      <div class="col-6 col-lg-3">
        <article class="card summary-card h-100 shadow-sm">
          <div class="card-body">
            <span class="text-secondary small">Pendientes</span>
            <strong class="summary-number d-block">{{summary.pending}}</strong>
          </div>
        </article>
      </div>
      <div class="col-6 col-lg-3">
        <article class="card summary-card h-100 shadow-sm">
          <div class="card-body">
            <span class="text-secondary small">En curso</span>
            <strong class="summary-number d-block text-primary">{{summary.in_progress}}</strong>
          </div>
        </article>
      </div>
      <div class="col-6 col-lg-3">
        <article class="card summary-card h-100 shadow-sm">
          <div class="card-body">
            <span class="text-secondary small">Completadas</span>
            <strong class="summary-number d-block text-success">{{summary.completed}}</strong>
          </div>
        </article>
      </div>
    </section>

    <div class="row g-4 align-items-start">
      <aside class="col-lg-4">
        <section class="card border-0 shadow-sm sticky-lg-top form-card">
          <div class="card-body p-4">
            <h2 class="h5 mb-1">Agregar una tarea</h2>
            <p class="text-secondary small mb-4">Completa los datos básicos para comenzar.</p>

            <form action="/tasks" method="post">
              <div class="mb-3">
                <label class="form-label" for="title">Título</label>
                <input
                  class="form-control"
                  id="title"
                  name="title"
                  type="text"
                  maxlength="80"
                  placeholder="Ej: Enviar informe"
                  required
                >
              </div>

              <div class="mb-3">
                <label class="form-label" for="description">Descripción</label>
                <textarea
                  class="form-control"
                  id="description"
                  name="description"
                  rows="3"
                  maxlength="240"
                  placeholder="Agrega un detalle opcional"
                ></textarea>
              </div>

              <div class="row g-3 mb-4">
                <div class="col-sm-6 col-lg-12 col-xl-6">
                  <label class="form-label" for="priority">Prioridad</label>
                  <select class="form-select" id="priority" name="priority">
                    <option value="low">Baja</option>
                    <option value="medium" selected>Media</option>
                    <option value="high">Alta</option>
                  </select>
                </div>
                <div class="col-sm-6 col-lg-12 col-xl-6">
                  <label class="form-label" for="dueDate">Fecha</label>
                  <input class="form-control" id="dueDate" name="dueDate" type="date">
                </div>
              </div>

              <button class="btn btn-primary w-100" type="submit">Guardar tarea</button>
            </form>
          </div>
        </section>
      </aside>

      <section id="tareas" class="col-lg-8" aria-labelledby="titulo-tareas">
        <div class="d-flex flex-column flex-sm-row justify-content-between gap-3 mb-3">
          <div>
            <h2 id="titulo-tareas" class="h4 mb-1">Mis tareas</h2>
            <p id="filter-summary" class="text-secondary small mb-0" aria-live="polite">
              {{summary.total}} de {{summary.total}} tareas visibles
            </p>
          </div>
          <label class="search-box" for="task-search">
            <span class="visually-hidden">Buscar tareas</span>
            <input
              class="form-control"
              id="task-search"
              type="search"
              placeholder="Buscar tarea..."
              autocomplete="off"
            >
          </label>
        </div>

        <div class="btn-group flex-wrap mb-3" role="group" aria-label="Filtrar tareas por estado">
          <button class="btn btn-primary" type="button" data-filter="all" aria-pressed="true">Todas</button>
          <button class="btn btn-outline-secondary" type="button" data-filter="pending" aria-pressed="false">Pendientes</button>
          <button class="btn btn-outline-secondary" type="button" data-filter="in_progress" aria-pressed="false">En curso</button>
          <button class="btn btn-outline-secondary" type="button" data-filter="completed" aria-pressed="false">Completadas</button>
        </div>

        <div id="task-list" class="vstack gap-3">
          {{#each tasks}}
            <article
              class="card task-item border-0 shadow-sm"
              data-task-card
              data-status="{{status}}"
              data-search="{{searchText}}"
            >
              <div class="card-body p-3 p-md-4">
                <div class="d-flex flex-column flex-sm-row justify-content-between gap-3">
                  <div class="task-content">
                    <div class="d-flex flex-wrap gap-2 mb-2">
                      <span class="badge {{statusClass}}">{{statusLabel}}</span>
                      <span class="badge {{priorityClass}}">Prioridad {{priorityLabel}}</span>
                    </div>
                    <h3 class="h5 mb-1 {{#if isCompleted}}text-decoration-line-through{{/if}}">{{title}}</h3>
                    {{#if description}}
                      <p class="text-secondary mb-2">{{description}}</p>
                    {{/if}}
                    <small class="text-secondary">Fecha: {{dueLabel}}</small>
                  </div>

                  <div class="d-flex flex-sm-column gap-2 task-actions">
                    <form action="/tasks/{{id}}/advance" method="post">
                      <button class="btn btn-outline-primary btn-sm w-100" type="submit">
                        {{nextActionLabel}}
                      </button>
                    </form>
                    <form action="/tasks/{{id}}/delete" method="post">
                      <button class="btn btn-outline-danger btn-sm w-100" type="submit">
                        Eliminar
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </article>
          {{/each}}
        </div>

        <div id="empty-state" class="card border-0 shadow-sm text-center p-5" hidden>
          <h3 class="h5">No se encontraron tareas</h3>
          <p class="text-secondary mb-3">Prueba con otro texto o cambia el filtro.</p>
          <button id="clear-filters" type="button" class="btn btn-outline-primary mx-auto">
            Limpiar filtros
          </button>
        </div>
      </section>
    </div>

    <aside class="alert alert-info mt-4 mb-0" role="note">
      <strong>Base para la próxima entrega:</strong>
      las tareas se guardan temporalmente mientras el servidor está activo. El siguiente paso es que este mismo flujo se conectará a una base de datos para que la información se mantenga aunque el servidor se reinicie.
    </aside>
  </main>

  <footer class="border-top bg-white py-3">
    <div class="container d-flex flex-column flex-sm-row justify-content-between gap-1 text-secondary small">
      <span>{{projectName}} · {{currentYear}}</span>
      <span>Node.js, Express, HBS y Bootstrap</span>
    </div>
  </footer>
</body>
</html>
