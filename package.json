{
  "name": "taskflow-backend-integrador",
  "version": "3.0.0",
  "description": "TaskFlow con API REST, PostgreSQL, Sequelize, JWT y Multer.",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node --test",
    "test:db": "node --test --test-concurrency=1 tests/database.integration.js tests/api.integration.js",
    "db:setup": "node scripts/setupDatabase.js",
    "db:check": "node scripts/checkDatabase.js",
    "check:views": "node scripts/checkViews.js",
    "check:postman:m7": "node scripts/checkPostman.js",
    "check:postman": "node scripts/checkPostman8.js",
    "check:openapi": "node scripts/checkOpenApi.js",
    "check": "npm test && npm run check:views && npm run check:postman && npm run check:openapi",
    "check:all": "npm run check && npm run test:db"
  },
  "keywords": [
    "node",
    "express",
    "hbs",
    "taskflow",
    "backend"
  ],
  "author": "Ignacio Osorio Opazo",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "hbs": "^4.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
